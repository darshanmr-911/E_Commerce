DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,10.0.2.2
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DB_NAME=freshkart
DB_USER=freshkart
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=5432
STORAGE_BACKEND=filesystem
# Set STORAGE_BACKEND=s3 and configure all values below for S3-compatible cloud storage.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OTP_HASH_KEY=replace-with-a-different-long-random-secret
SMS_OTP_PROVIDER=disabled
SMS_PROVIDER_TIMEOUT_SECONDS=10
# For MSG91, use a DLT-approved template containing {#var#} as the OTP variable.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_TEMPLATE_VARIABLE=VAR1
MSG91_OTP_API_URL=https://control.msg91.com/api/v5/flow
# Alternative: an HTTPS JSON gateway adapter that accepts the documented contract.
SMS_HTTP_JSON_API_URL=
SMS_HTTP_JSON_API_TOKEN=
SMS_HTTP_JSON_TEMPLATE_ID=
